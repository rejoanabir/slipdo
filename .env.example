# =====================================================================
# Payment Receipt SaaS - Environment Configuration
# =====================================================================

# App URLs
NEXT_PUBLIC_APP_NAME="Payment Receipt"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Replace with your actual keys when ready)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI OCR (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key"

# Email Services (Resend)
RESEND_API_KEY="re_123456789"
SENDER_EMAIL="receipts@yourdomain.com"

# Bangladesh SMS Gateway (e.g. SSL Wireless / BulkSMSBD)
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="RECEIPT"

# Payment Gateway (SSLCommerz)
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASS="your_store_pass"
SSLCOMMERZ_IS_SANDBOX=true
